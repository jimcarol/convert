# syntax=docker/dockerfile:1
FROM golang:1.24.2-alpine AS builder

RUN apk add --no-cache gcc g++ libc-dev libwebp-dev

ENV CGO_ENABLED=1
WORKDIR /app
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -o /out/heavy ./cmd/heavy

# 运行时依赖(LibreOffice/JRE/字体)在 base 镜像中预先装好,见 Dockerfile.heavy-base;
# base 缺失时先构建:docker compose --profile base build heavy-base
FROM converter-heavy-base:v1

ARG VERSION="dev"
ARG GIT_COMMIT="unknown"
ARG BUILD_DATE=""
ARG FEATURES=""

LABEL org.opencontainers.image.title="converter-heavy" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.description="Heavy converter: lite features + LibreOffice document conversion" \
      app.variant="heavy" \
      app.features="${FEATURES}"

WORKDIR /root/
COPY --from=builder /out/heavy ./heavy

EXPOSE 8080

ENV FONT_PATH="/usr/share/fonts/wqy-zenhei/wqy-zenhei.ttc"
ENV JWT_SECRET=""
ENV PORT="8080"

CMD ["./heavy"]
